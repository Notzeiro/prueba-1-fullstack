# Copia este archivo a ".env" y completa los valores reales.
# Nunca commitees el ".env" real: contiene secretos.

DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
# Lista separada por comas de hosts permitidos (sin protocolo).
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Lista separada por comas de origenes confiables para CSRF (con protocolo).
# Necesario en produccion detras de un proxy/tunel HTTPS, ej:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://vynilstore.notzeiro.tech
DJANGO_CSRF_TRUSTED_ORIGINS=

DB_NAME=vinyl_hub
DB_USER=tienda_user
DB_PASSWORD=cambia-esto
DB_HOST=localhost
DB_PORT=5432
